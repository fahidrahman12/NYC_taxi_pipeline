# Copy this file to .env and fill in your values
# Never commit .env to version control

# GCP Project
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=US

# GCS bucket that will store raw Parquet files (will be created if missing)
GCS_BUCKET_NAME=your-bucket-name-nyc-taxi-raw

# BigQuery datasets (will be created if missing)
BQ_DATASET_RAW=nyc_taxi_raw

# Path to your GCP service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
